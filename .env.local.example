# Kopiera till .env.local och fyll i från Supabase > Project Settings > API.

# Publika nycklar — får finnas i webbläsaren
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Användarnamnen på /admin översätts till e-post med den här domänen.
# Skapar du användaren oscar@fornsvenska.local loggar du in som "oscar".
NEXT_PUBLIC_ADMIN_EPOSTDOMAN=fornsvenska.local

# Endast för seed-skriptet. Får ALDRIG börja med NEXT_PUBLIC och ska aldrig
# checkas in — den går förbi alla säkerhetsregler.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
